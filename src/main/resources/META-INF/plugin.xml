<idea-plugin>
  <id>com.floxy.flow.viewer</id>
  <name>Floxy Flow Viewer</name>
  <vendor email="roman.chudov@gmail.com" url="https://github.com/rom8726/floxy-goland-plugin">Chudov Roman</vendor>
  <version>0.3.0</version>
  <idea-version since-build="262.0" until-build="262.*"/>
  <description><![CDATA[
    Visualize and validate floxy.Builder workflows in GoLand.
  ]]></description>
  <change-notes><![CDATA[
    0.3.0
    - Added compatibility with GoLand 2026.2 / build 262.*.
    - Updated the plugin build to Kotlin 2.4.0 to match the IDE platform.

    0.2.0
    - Initial public preview release.
  ]]></change-notes>

  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.go</depends>

  <extensions defaultExtensionNs="com.intellij">
    <projectService serviceImplementation="com.floxy.viewer.services.FlowModelService"/>
    <toolWindow id="Floxy" factoryClass="com.floxy.viewer.ui.FloxyToolWindowFactory" anchor="left" icon="AllIcons.Actions.ListFiles"/>
  </extensions>

  <actions>
    <group id="com.floxy.viewer.Group" text="Floxy Flow Viewer" popup="true">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </group>

    <action id="com.floxy.viewer.ShowFlowDiagramAction" class="com.floxy.viewer.actions.ShowFlowDiagramAction" text="Show PlantUML Diagram" description="Parse and show Floxy flow diagram">
      <add-to-group group-id="com.floxy.viewer.Group" anchor="first"/>
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift F"/>
    </action>

    <action id="com.floxy.viewer.ShowMermaidDiagramAction" class="com.floxy.viewer.actions.ShowMermaidDiagramAction" text="Show Mermaid Diagram" description="Parse and show Floxy flow in Mermaid format">
      <add-to-group group-id="com.floxy.viewer.Group" anchor="after" relative-to-action="com.floxy.viewer.ShowFlowDiagramAction"/>
    </action>

    <action id="com.floxy.viewer.ExportToPlantUMLAction" class="com.floxy.viewer.actions.ExportToPlantUMLAction" text="Export Floxy Flow to PlantUML" description="Export Floxy flow to .puml">
      <add-to-group group-id="com.floxy.viewer.Group" anchor="after" relative-to-action="com.floxy.viewer.ShowMermaidDiagramAction"/>
    </action>

    <action id="com.floxy.viewer.ExportToMermaidAction" class="com.floxy.viewer.actions.ExportToMermaidAction" text="Export Floxy Flow to Mermaid" description="Export Floxy flow to .mmd">
      <add-to-group group-id="com.floxy.viewer.Group" anchor="after" relative-to-action="com.floxy.viewer.ExportToPlantUMLAction"/>
    </action>

    <action id="com.floxy.viewer.ExportToImageAction" class="com.floxy.viewer.actions.ExportToImageAction" text="Export Floxy Diagram as Image" description="Export PlantUML-rendered diagram as PNG/SVG">
      <add-to-group group-id="com.floxy.viewer.Group" anchor="after" relative-to-action="com.floxy.viewer.ExportToMermaidAction"/>
    </action>

    <action id="com.floxy.viewer.ValidateFlowAction" class="com.floxy.viewer.actions.ValidateFlowAction" text="Validate Floxy Flow" description="Validate flow graph">
      <add-to-group group-id="com.floxy.viewer.Group" anchor="after" relative-to-action="com.floxy.viewer.ExportToImageAction"/>
    </action>
  </actions>
</idea-plugin>
